# Atria server environment.
#
#   cp .env.example .env    then replace every CHANGE_ME.
#
# This file is the template and IS committed; `.env` is not (see .gitignore).
# Never put a real secret in this file.
#
# Generate the two secrets with:
#   openssl rand -base64 48
# On Windows without openssl, use Git Bash's `openssl`, or:
#   docker run --rm alpine/openssl rand -base64 48

# --- Postgres superuser ------------------------------------------------------
# Used only to initialise the cluster and to run migrations. The API never
# connects as this user.
POSTGRES_USER=atria_superuser
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_superuser_password
POSTGRES_DB=atria

# --- Application role --------------------------------------------------------
# What the API connects as. Owns no tables, so row-level security actually
# applies to it.
ATRIA_DB_USER=atria_api
ATRIA_DB_PASSWORD=CHANGE_ME_app_password

# --- API ---------------------------------------------------------------------
# Must be at least 32 characters, or the API refuses to start.
ATRIA_JWT_SECRET=CHANGE_ME_at_least_32_chars_openssl_rand_base64_48
ATRIA_JWT_ISSUER=api.apexbooks.in
ATRIA_ACCESS_TOKEN_TTL=15m
ATRIA_REFRESH_TOKEN_TTL=30d
ATRIA_LOG_LEVEL=info
ATRIA_VERSION=0.1.0
ATRIA_PUBLIC_BASE_URL=https://api.apexbooks.in
ATRIA_MAX_BODY_BYTES=262144

# Host port nginx proxies to. Bound to 127.0.0.1 only, so it is never public.
# Change this if something else already listens on 8080.
API_HOST_PORT=8080
